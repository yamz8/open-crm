# Copy to .env and edit. Every value here has a working default except the secret.

# Required in production. Generate with: openssl rand -hex 32
# Session cookies and API tokens are keyed to this value — changing it logs
# everyone out and invalidates every token.
OPEN_CRM_SECRET=

# Where the server listens.
HOST=0.0.0.0
PORT=4000

# The externally reachable URL. Used in the OpenAPI document, the discovery
# payload, and to decide whether session cookies get the Secure flag.
PUBLIC_URL=http://localhost:4000

# SQLite file. Relative paths resolve against the project root.
DATABASE_URL=data/open-crm.db

# development | production | test
NODE_ENV=development

# silent | error | warn | info | debug | trace
LOG_LEVEL=info

# How long a browser session lasts.
SESSION_TTL_HOURS=336

# Per-token (or per-IP when anonymous) request budget.
RATE_LIMIT_MAX=600
RATE_LIMIT_WINDOW_MS=60000

# Password attempts get their own, much smaller bucket, keyed by client IP.
# Keep this low: the general budget above is far too generous for guessing.
LOGIN_RATE_LIMIT_MAX=10
LOGIN_RATE_LIMIT_WINDOW_MS=300000

# Allow POST /api/v1/setup to create the first owner. Set false once set up.
ALLOW_SETUP=true

# Only enable behind a reverse proxy you control — it makes the app trust
# X-Forwarded-* headers for client IPs and rate limiting.
TRUST_PROXY=false

WEBHOOK_TIMEOUT_MS=10000

# Webhook deliveries to private, loopback, and link-local addresses are blocked,
# so a webhook cannot be used to probe the host's network or reach a cloud
# metadata endpoint. Enable only if you deliver to a sibling container you trust.
WEBHOOK_ALLOW_PRIVATE=false
